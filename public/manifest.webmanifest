{
  "name": "Nepali Type",
  "short_name": "Nepali Type",
  "description": "Type Nepali in Unicode and Devanagari font (Preeti layout). Direct, Romanized or font keys. Works offline.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#faf8f5",
  "theme_color": "#c8102e",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Type directly",
      "short_name": "Direct",
      "description": "Type in the box, words turn into Nepali",
      "url": "/?m=direct",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Type in Romanized",
      "short_name": "Romanized",
      "description": "Type ka, get क",
      "url": "/?m=roman",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Type or paste Preeti",
      "short_name": "Preeti",
      "description": "Preeti keys to Unicode",
      "url": "/?m=preeti",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Cheatsheet",
      "short_name": "Cheatsheet",
      "description": "Every letter and key",
      "url": "/chart/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text"
    }
  }
}
