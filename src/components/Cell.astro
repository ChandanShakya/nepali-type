---
// One cheatsheet cell: the letter, its Romanized spelling (blue), its font keys (grey) and other spellings.
const { e, half = false, note } = Astro.props;
// half letters get a ZWJ so they show their half shape; signs like ्र get a dotted circle
const label = half ? e.u + "\u200d" : /^[\u0900-\u0903\u093a-\u094f]/.test(e.u) ? "\u25cc" + e.u : e.u;
---
<div class:list={["c", { h: half }]}>
  <span class="d">{label}</span>
  <kbd class="kr">{e.r ?? "—"}</kbd>
  <kbd>{e.p ?? "—"}</kbd>
  {e.alt.length > 0 && <small>also {e.alt.join(" ")}</small>}
  {note && <small>{note}</small>}
  {e.code && <small>Alt+{e.code}</small>}
</div>
<style>
.c{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 6px;text-align:center}
.c.h{background:var(--half)}
.d{display:block;font-size:28px;line-height:1.3}
kbd{display:block;width:max-content;margin:3px auto 0}
small{display:block;color:var(--mut);font-size:11.5px;margin-top:3px}
</style>
