---
// Printable cheatsheet. Everything is computed at build time from the same converter the app uses.
import "../styles/base.css";
import {REPO, GITHUB_ICON} from "../data/site.js";
import Cell from "../components/Cell.astro";
import {R,SH2,P,roman,toPreeti} from "../scripts/nepali.js";
import {VOWELS,CONSONANT_ROWS,CONSONANTS,MATRAS,CONJUNCTS,PUNCT,SPECIALS,entry} from "../scripts/charts.js";

const site = Astro.site?.href ?? "/";
const url = new URL("/chart/", site).href;
const dsp = (u: string) => u.replace(/्$/, "्‍");
const sign = (v: string) => (/^[ािीुूृेैोौंँः्]/.test(v) ? "◌" + v : dsp(v));
const glyph = (c: string) => (c === "m" ? "hook" : P[c] === undefined ? "" : sign(P[c].replace("\u0001", "ि").replace("\u0002", "र्")));

// the alphabet comes from scripts/charts.js, the same data as the in-app chart
const signs: [string, string][] = [["कं", "anusvara ं"], ["कँ", "chandrabindu ँ"], ["कः", "visarga ः"], ["क्", "halant ्"]];
const words = ["namaste", "nepaal", "dhanyawaad", "kShetra", "gyaan", "shrii", "dharma", "kRiShi", "gangaa", "maanchhe", "saMsaar", "chaa~d", "chhan\\"];

const title = "Nepali Typing Cheatsheet & Guide: Romanized Nepali and Preeti Keyboard Layout";
const desc = "How to type Nepali: every Romanized spelling, the full Preeti / Devanagari font keyboard layout, the vowel table (बाह्रखरी), half letters, conjuncts and a guide to every Nepali Type feature.";
// every feature, documented once here: [title, how it works]
const features: [string, string][] = [
  ["Romanized typing", "Type Nepali the way it sounds in English letters: <kbd>ka</kbd> क, <kbd>kaa</kbd> का, <kbd>namaste</kbd> नमस्ते. A consonant alone keeps its <b>a</b> sound and two consonants join (<kbd>kt</kbd> क्त). Works with any phone keyboard."],
  ["Dictionary suggestions", "About 800 common words are built in and work offline. Loose spellings still find the word: <kbd>nepal</kbd> → नेपाल, <kbd>bikas</kbd> → विकास, <kbd>kathmandu</kbd> → काठमाडौं. Tap a blue suggestion, or press <kbd>Tab</kbd> on a computer. In font keys mode the dictionary finishes the word you are typing."],
  ["Live hints", "The bar above the keyboard shows what each key did and what you can type next: after <kbd>k</kbd> it offers ख, का, कि and the rest. Tap a hint to type it."],
  ["Devanagari font keys (Preeti layout)", "The classic Devanagari font keyboard, keystroke for keystroke, as in Word or LibreOffice with the Preeti font. Use the on-screen keyboard or a physical one. <b>ि</b> is typed before its letter and reph र् after; the app puts them in the right Unicode order. Shift: tap once, twice to lock."],
  ["Movable cursor", "In font keys mode you can insert anywhere: <b>tap the text</b> to put the cursor there, <b>drag the space bar</b> left or right to move it (like Gboard), or use the arrow keys, Home, End and Delete on a keyboard. Typing, ⌫, hints and dictionary words all work at the cursor."],
  ["Three outputs, side by side", "Every word appears as Unicode (for the web, phones and modern apps), as Romanized spelling (to learn it or type it again) and as Devanagari font keystrokes (to paste into documents set in Preeti)."],
  ["Same text in both modes", "Switching between Romanized and font keys converts what you typed, so you never lose your text."],
  ["Copy any box", "Each box has its own copy button in the top-right corner. A tick confirms which one was copied."],
  ["Saved words", "Press <b>★ Save</b> to keep the word before the cursor. Saved words appear in the suggestion bar and under <b>★ Saved</b>, where you can tap to type them or × to remove them. They stay on your device."],
  ["Chart and this cheatsheet", "<b>Chart</b> in the bottom row opens a quick reference inside the app; this page is the full printable version."],
  ["More room", "Hide the top bar with <b>⌃</b>. Card titles disappear and buttons become icons. Bring it back with <b>⌄</b> in the bottom row."],
  ["Dark mode", "Follows your system until you pick one with the moon button."],
  ["Install and offline", "Install it from the browser (Chrome, Edge, Android: Install button; iPhone: Share → Add to Home Screen). After the first visit it works with no internet."],
  ["Private", "Everything runs in your browser. Text, saved words and settings never leave your device. No account, no tracking."],
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={desc}>
<link rel="canonical" href={url}>
<meta property="og:type" content="article">
<meta property="og:url" content={url}>
<meta property="og:title" content={title}>
<meta property="og:description" content={desc}>
<meta property="og:image" content={new URL("/og.png", site).href}>
<meta name="theme-color" content="#faf8f5">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<script is:inline>
try{const t=localStorage.getItem("nw-theme");if(t)document.documentElement.dataset.theme=t}catch(e){}
</script>
<style>
:global(html),:global(body){height:auto}
.wrap{max-width:980px;margin:0 auto;padding:0 16px 48px}
.top{position:sticky;top:0;z-index:3;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 0;padding-top:max(10px,env(safe-area-inset-top))}
.top .in{max-width:980px;margin:0 auto;padding:0 16px;display:flex;align-items:center;gap:10px}
.logo{width:32px;height:32px;border-radius:9px;background:var(--ac);color:var(--ac-fg);display:grid;place-items:center;font-size:20px;font-weight:700;flex:none;text-decoration:none}
.top b{flex:1;font-size:17px}
.btn{height:34px;padding:0 14px;border-radius:17px;background:var(--ac);color:var(--ac-fg);font-weight:600;font-size:14px;display:inline-flex;align-items:center;text-decoration:none;white-space:nowrap}
nav{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;max-width:980px;margin:8px auto 0;padding:0 16px}
nav::-webkit-scrollbar{display:none}
nav a{flex:none;padding:5px 12px;border-radius:14px;background:var(--surface2);color:var(--fg);text-decoration:none;font-size:13.5px;font-weight:550}
h1{font-size:clamp(26px,5vw,38px);letter-spacing:-.02em;margin:28px 0 4px}
.lead{color:var(--mut);margin:0 0 8px;font-size:16px}
h2{font-size:22px;margin:36px 0 4px;scroll-margin-top:110px;display:flex;align-items:center;gap:10px}
h2 span{font-size:12px;font-weight:600;color:var(--ac);background:var(--ac-soft);padding:2px 9px;border-radius:10px}
h3{font-size:15px;margin:20px 0 8px;color:var(--mut);font-weight:600}
.note{color:var(--mut);margin:4px 0 12px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(62px,1fr));gap:6px}
.row5{margin-bottom:8px}
/* the jump bar sits under the sticky page header; rows stop below both when jumped to */
.wrap .jump{top:96px;margin:4px 0 8px}
.vr{scroll-margin-top:150px}
:global(kbd){font:12px ui-monospace,monospace;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:0 5px;background:var(--surface2);color:var(--fg);display:inline-block;margin:1px}
.ex{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px}
.ex div{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:8px 12px;display:flex;align-items:center;gap:10px}
.ex .d{font-size:24px;flex:1}
.ex code{color:var(--mut);font-size:12px}
.kb{background:var(--surface2);border-radius:16px;padding:10px}
@media (max-width:640px){.kb .row{flex-wrap:wrap;padding-left:0!important}.kb .k{flex:0 0 calc((100% - 30px)/7);height:60px}.kb .row+.row{margin-top:10px}}
.row{display:flex;gap:5px;margin-bottom:5px}
.row:nth-child(2){padding-left:3%}.row:nth-child(3){padding-left:6%}.row:nth-child(4){padding-left:10%}
.k{flex:1;min-width:0;background:var(--key);border-radius:9px;box-shadow:0 1px 0 var(--keyline),0 0 0 1px var(--line) inset;padding:3px 4px 4px;position:relative;height:66px}
.k i{position:absolute;top:2px;left:5px;font:normal 10px ui-monospace,monospace;color:var(--mut)}
.k .s{position:absolute;top:3px;right:5px;font-size:15px;color:var(--blue)}
.k .n{position:absolute;bottom:4px;left:0;right:0;text-align:center;font-size:23px}
.k.m .n{font:11px system-ui;color:var(--ac);bottom:10px}
.leg{display:flex;gap:14px;flex-wrap:wrap;color:var(--mut);font-size:13px;margin:8px 2px 0}
.leg b{color:var(--blue)}
ul{padding-left:20px}li{margin:6px 0}
footer{margin-top:40px;color:var(--mut);font-size:13px}
footer a{color:var(--ac)}
.gl{width:34px;height:34px;display:grid;place-items:center;color:var(--fg)}
.gl .gh{width:20px;height:20px;fill:currentColor}
.demo{margin:18px 0 6px;text-align:center}
.demo video{width:auto;max-width:100%;height:min(70vh,640px);border-radius:16px;background:#0e0e0f;box-shadow:var(--shadow)}
.demo figcaption{color:var(--mut);font-size:13px;margin-top:6px}
.ft{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin:8px 0}
.ft div{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.ft dt{font-weight:700;margin-bottom:4px}
.ft dd{margin:0;color:var(--mut);font-size:14.5px;line-height:1.5}
/* off-screen sections are laid out only when scrolled near: the page has ~2,300 Devanagari elements */
.vr,.ft div,.grid,.ex,.kb{content-visibility:auto;contain-intrinsic-size:auto 160px}
@media print{.demo{display:none}.vr,.ft div,.grid,.ex,.kb{content-visibility:visible}.top,nav{display:none}.wrap{max-width:none}.c,.ex div,.k{break-inside:avoid}h2{break-after:avoid}.vr{break-inside:avoid}}
</style>
</head>
<body>
<header class="top">
 <div class="in"><a class="logo d" href="/" aria-label="Back to Nepali Type">क</a><b>Cheatsheet</b><a class="gl" href={REPO} target="_blank" rel="noopener" aria-label="Source code on GitHub" title="Source code on GitHub"><Fragment set:html={GITHUB_ICON}/></a><a class="btn" href="/">Start typing →</a></div>
 <nav aria-label="Sections"><a href="#features">Features</a><a href="#alphabet">Alphabet</a><a href="#table">Vowel table</a><a href="#half">Half letters</a><a href="#signs">Signs</a><a href="#specials">Specials</a><a href="#roman">Romanized rules</a><a href="#layout">Font keyboard</a><a href="#tips">Tips</a></nav>
</header>
<main class="wrap">
 <h1>Nepali typing cheatsheet</h1>
 <p class="lead">Two ways to type in <a href="/" style="color:var(--ac)">Nepali Type</a>: <b>Romanized</b> (type how it sounds) and <b>Font keys</b> (the classic Devanagari font layout, as used by Preeti).</p>
 <figure class="demo"><video src="/demo.mp4" poster="/demo.webp" controls muted playsinline preload="none" width="720" height="1280" aria-label="Nepali Type demo video"></video><figcaption>Every feature in under a minute.</figcaption></figure>

 <h2 id="features">Features <span>how to use</span></h2>
 <dl class="ft">{features.map(([t, d]) => <div><dt>{t}</dt><dd set:html={d}></dd></div>)}</dl>

 <h2 id="alphabet">Alphabet <span>वर्णमाला</span></h2>
 <p class="note">Every cell shows the letter, its <kbd class="kr">Romanized</kbd> spelling (blue) and its <kbd>font keys</kbd> (grey, Preeti layout). The app's Chart uses this same table, and every spelling is tested to type back exactly.</p>
 <h3 id="vowels">Vowels</h3>
 <div class="grid">{VOWELS.map(entry).map(e => <Cell e={e} />)}</div>
 <h3 id="consonants">Consonants</h3>
 {CONSONANT_ROWS.map(row => <div class="grid row5">{row.map(entry).map(e => <Cell e={e} />)}</div>)}

 <h2 id="table">Vowel table <span>बाह्रखरी</span></h2>
 <p class="note">Every consonant with every vowel sign. Blue: Romanized. Grey: font keys. "—" means the font has no key for it.</p>
 <nav class="jump" aria-label="Jump to a letter">{CONSONANTS.map((c, i) => <a href={"#v" + i}>{c}</a>)}</nav>
 <div class="vt">{CONSONANTS.map((c, i) => <div class="vr" id={"v" + i}><b class="d">{c}</b><div class="vc">{MATRAS.map(m => entry(c + m)).map(e => <div><span class="d">{e.u}</span><kbd class="kr">{e.r}</kbd><kbd>{e.p ?? "—"}</kbd></div>)}</div></div>)}</div>

 <h2 id="half">Half letters and conjuncts</h2>
 <p class="note">A half letter joins the next one: <kbd class="kr">k</kbd>+<kbd class="kr">t</kbd> (Romanized) or <kbd>S</kbd>+<kbd>t</kbd> (font keys) gives क्त.</p>
 <div class="grid">{CONSONANTS.map(c => entry(c + "्")).map(e => <Cell e={e} half />)}</div>
 <h3>Common conjuncts</h3>
 <div class="grid">{CONJUNCTS.map(entry).map(e => <Cell e={e} />)}</div>

 <h2 id="signs">Signs, punctuation and digits</h2>
 <div class="grid">{signs.map(([u, n]) => <Cell e={entry(u)} note={n} />)}</div>
 <div class="grid">{PUNCT.map(entry).map(e => <Cell e={e} />)}</div>
 <h3 id="specials">Specials</h3>
 <p class="note">Extra glyphs in the Preeti font. In Windows apps type them with the Alt code (hold Alt, type the number on the keypad). ॐ and ऽ are Unicode-only: they have no font key or Romanized spelling.</p>
 <div class="grid">{SPECIALS.map(e => <Cell e={e} />)}</div>

 <h2 id="roman">Romanized rules <span>ka → क</span></h2>
 <ul>
  <li>A consonant alone keeps its <b>a</b> sound: <kbd class="kr">k</kbd> क. Two consonants in a row join: <kbd class="kr">kt</kbd> क्त.</li>
  <li>Capitals matter: <kbd class="kr">t</kbd> त, <kbd class="kr">T</kbd> ट; <kbd class="kr">sh</kbd> श, <kbd class="kr">Sh</kbd> ष; <kbd class="kr">n</kbd> न, <kbd class="kr">N</kbd> ण.</li>
  <li><kbd class="kr">n</kbd> before k, kh, g or gh becomes ङ: <kbd class="kr">gangaa</kbd> गङ्गा.</li>
  <li><kbd class="kr">\</kbd> adds a halant at the end of a word: <kbd class="kr">chhan\</kbd> छन्. <kbd class="kr">'</kbd> keeps letters apart: <kbd class="kr">ra'aa</kbd> रआ, <kbd class="kr">k'kh</kbd> कख.</li>
  <li><kbd class="kr">.</kbd> types । and <kbd class="kr">..</kbd> types a full stop. Digits become ०–९.</li>
  <li>Loose spellings are fine: the dictionary suggests <b>नेपाल</b> for <kbd class="kr">nepal</kbd> and <b>विकास</b> for <kbd class="kr">bikas</kbd>.</li>
 </ul>
 <h3>Examples</h3>
 <div class="ex">{words.map(w => <div><kbd class="kr">{w}</kbd><span class="d">{roman(w).u}</span><code>{toPreeti(roman(w).u)}</code></div>)}</div>
 <p class="note">The grey code is the same word as font keystrokes.</p>

 <h2 id="layout">Devanagari font keyboard <span>s → क</span></h2>
 <p class="note">This is the Preeti layout, the most widely used legacy Devanagari font. Each key is one glyph. Bottom: the key alone. Top right, in blue: with Shift.</p>
 <div class="kb">{R.map(([a]) => <div class="row">{[...a].map(c => <div class={"k d" + (c === "m" ? " m" : "")}><i>{c}</i><span class="s">{glyph(SH2[c])}</span><span class="n">{glyph(c)}</span></div>)}</div>)}</div>
 <div class="leg"><span><b>Blue</b> = Shift layer</span><span><kbd>m</kbd> = hook (km फ, pm ऊ, em झ)</span><span>US QWERTY</span></div>

 <h2 id="tips">Tips</h2>
 <ul>
  <li><b>ि</b> is typed <i>before</i> its letter in font mode: <kbd>l</kbd><kbd>s</kbd> कि. The app puts it in the right Unicode order.</li>
  <li><b>Reph र्</b> is typed <i>after</i> its letter: <kbd>c</kbd><kbd>y</kbd><kbd>{"{"}</kbd> अर्थ.</li>
  <li><b>m</b> is a hook, not a letter: <kbd>km</kbd> फ, <kbd>pm</kbd> ऊ, <kbd>em</kbd> झ, <kbd>qm</kbd> क्र, <kbd>Qm</kbd> क्त. For म type <kbd>d</kbd>.</li>
  <li><kbd>0f</kbd>, <kbd>if</kbd> and <kbd>If</kbd> are single letters: ण, ष, क्ष.</li>
  <li>Press <b>★ Save</b> in the app to keep a word. Saved words appear in the suggestion bar.</li>
 </ul>
 <footer>Nepali Type is free, open source, works offline and keeps everything on your device. <a href="/">Start typing →</a> · <a href={REPO} target="_blank" rel="noopener">Source on GitHub</a></footer>
</main>
<script>
if(import.meta.env.PROD&&"serviceWorker" in navigator)navigator.serviceWorker.register("/sw.js").catch(()=>{});
</script>
</body>
</html>
