---
import "../styles/base.css";
import {REPO, GITHUB_ICON} from "../data/site.js";
const site = Astro.site?.href ?? "/";
const title = "Nepali Type: Romanized Nepali & Preeti Unicode Typing (Free, Offline)";
const desc = "Free Nepali typing app: type Romanized (ka → क, namaste → नमस्ते) with word suggestions, or use the classic Preeti Devanagari font layout. Unicode and Preeti text side by side. Works offline, no sign-up.";
const video = new URL("/demo.mp4", site).href;
// structured data so search engines know this is a free web app
const ld = JSON.stringify({"@context":"https://schema.org","@type":"WebApplication",name:"Nepali Type",url:site,description:desc,
  applicationCategory:"UtilitiesApplication",operatingSystem:"Any (web browser)",inLanguage:["ne","en"],isAccessibleForFree:true,
  offers:{"@type":"Offer",price:"0",priceCurrency:"USD"},image:new URL("/og.png", site).href,sameAs:[REPO],
  featureList:["Romanized Nepali typing (ka → क)","Built-in Nepali dictionary suggestions","Preeti / Devanagari font keyboard layout","Type or paste Preeti text and get Unicode and Romanized","Unicode and Preeti output side by side","Saved words","Printable cheatsheet","Dark mode","Works offline, installable PWA"]});
const copy = '<svg viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>';
const star = '<svg viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z"/></svg>';
const book = '<svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg>';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
<title>{title}</title>
<meta name="description" content={desc}>
<link rel="canonical" href={site}>
<meta property="og:type" content="website">
<meta property="og:url" content={site}>
<meta property="og:title" content={title}>
<meta property="og:description" content={desc}>
<meta property="og:image" content={new URL("/og.png", site).href}>
<meta property="og:video" content={video}>
<meta property="og:video:type" content="video/mp4">
<meta name="keywords" content="Nepali typing, Nepali Unicode, Preeti to Unicode, Romanized Nepali, Nepali keyboard, Devanagari typing, नेपाली टाइपिङ, युनिकोड">
<script type="application/ld+json" set:html={ld}></script>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#faf8f5">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon-180.png">
<script is:inline>
// apply saved theme and top bar state before first paint so nothing flashes
try{const t=localStorage.getItem("nw-theme");if(t)document.documentElement.dataset.theme=t;if(localStorage.getItem("nw-hd")==="0")document.documentElement.classList.add("hd-off");const q=new URLSearchParams(location.search).get("m"),m=q==="roman"||q==="preeti"?q:localStorage.getItem("nw-mode");if(m!=="preeti")document.documentElement.classList.add("roman")}catch(e){document.documentElement.classList.add("roman")}
</script>
<style is:global>
.app{display:flex;flex-direction:column;height:var(--vh,100dvh);max-width:820px;margin:0 auto}
/* header */
header{display:flex;align-items:center;gap:6px;padding:10px 10px 6px 14px;padding-top:max(10px,env(safe-area-inset-top))}
.hd-off header{display:none}
.brand{display:flex;align-items:center;gap:9px;flex:1;min-width:0}
.logo{width:32px;height:32px;border-radius:9px;background:var(--ac);color:var(--ac-fg);display:grid;place-items:center;font-size:20px;font-weight:700;flex:none}
.brand>div{min-width:0}
.brand h1{margin:0;overflow:hidden;text-overflow:ellipsis;font-size:17px;font-weight:650;letter-spacing:-.01em;white-space:nowrap;line-height:1.3}
.brand small{display:block;color:var(--mut);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pill{height:34px;padding:0 14px;border-radius:17px;font-size:13.5px;font-weight:600;flex:none;display:inline-flex;align-items:center;background:var(--ac);color:var(--ac-fg)}
.ib{width:38px;height:38px;border-radius:19px;display:grid;place-items:center;color:var(--mut);flex:none}
.ib:hover{background:var(--surface2);color:var(--fg)}
.gh{fill:currentColor;stroke:none}
#showhd{display:none}.hd-off #showhd{display:inline-flex;flex:.8 1 0}
/* main: scrolls on its own, the dock stays put */
#top{flex:1;overflow:auto;overscroll-behavior:contain;padding:4px 14px 12px;min-height:0;display:flex;flex-direction:column;gap:10px}
.hd-off #top{padding-top:10px}
.card{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);flex:none}
/* each output box copies its own text from its corner */
/* copy, save and clear share one button look: 38px tall, 1px border, 10px radius */
.cc,.pb{position:absolute;top:6px;right:6px;width:38px;height:38px;border:1px solid var(--line);border-radius:10px;background:var(--surface);display:grid;place-items:center;color:var(--fg);transition:transform .08s}
.cc:active,.pb:active{transform:scale(.94)}
.cc:hover,.pb:hover{background:var(--surface2);color:var(--fg)}
.pb{right:50px}
.roman .pb{display:none}
html:not(.roman) #pk .lab{padding-right:92px}
.cc.ok{color:var(--ac);border-color:var(--ac);background:var(--ac-soft)}
.card:has(.cc) .lab{padding-right:48px}
.hd-off #rin,.hd-off #pin,.hd-off #out,.hd-off #rom,.hd-off #pre{padding-right:48px}
#rin,#pin{display:block;width:100%;min-height:64px;resize:vertical;border:0;border-radius:0 0 16px 16px;padding:4px 16px 12px;font:18px/1.45 ui-monospace,"SF Mono",Menlo,Consolas,monospace;background:none;color:var(--fg)}
#rin:focus,#pin:focus{outline:none}
#rc:focus-within,#pk:focus-within{border-color:var(--ac);box-shadow:0 0 0 3px var(--ac-soft)}
#rin::placeholder,#pin::placeholder{color:var(--mut)}
#pin{font-size:20px;letter-spacing:.03em}
.lab{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;padding:10px 16px 0}
/* collapsed (top bar hidden): no card titles, icon-only buttons, room for the restore button */
.hd-off .lab{display:none}
.hd-off #rin,.hd-off #pin,.hd-off #out,.hd-off #rom,.hd-off #pre{padding-top:12px}
.hd-off .acts .bt .tx{display:none}
.hd-off .acts .bt svg{display:inline-block!important}
.hd-off .acts .bt,#cl{padding:0;width:38px}
#out{min-height:96px;padding:4px 16px 10px;font-size:32px;line-height:1.6;word-break:break-word;white-space:pre-wrap}
#out.e{color:var(--mut);font-size:16px;line-height:1.5;padding-top:10px}
#out.e b{color:var(--fg)}
html:not(.roman) #rin{display:none}
/* Preeti mode: the Preeti box is the input and goes first; its read-only output copy is hidden */
.roman #pin{display:none}
html:not(.roman) #pre{display:none}
html:not(.roman) #pk{order:-1}
.sm{font:italic 16px ui-monospace,monospace;color:var(--ac);border-bottom:2px dotted var(--ac);margin:0 1px}
.acts{display:flex;gap:6px;padding:0 10px 10px;align-items:center}
.bt{white-space:nowrap;flex:none;height:38px;min-width:38px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--surface);font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:6px;transition:transform .08s}
.bt:active{transform:scale(.96)}
.bt.p{background:var(--ac);border-color:var(--ac);color:var(--ac-fg)}
.bt.fav.on{color:var(--ac);border-color:var(--ac);background:var(--ac-soft)}
.bt.fav.on svg{fill:currentColor}
.sp{flex:1}
/* the keys to press, always as plain characters: never drawn in an installed Preeti font */
#pre{padding:2px 16px 12px;min-height:44px;font:22px/1.5 ui-monospace,"SF Mono",Menlo,Consolas,monospace;letter-spacing:.03em;word-break:break-all;white-space:pre-wrap}
/* Preeti mode: the same text spelled the Romanized way, to learn or reuse it */
/* one Romanized box in both modes: the input on top in Romanized mode, read-only spelling in Preeti mode */
.roman #rc{order:-1}.roman #rom{display:none}
#rom{padding:2px 16px 12px;min-height:40px;font:18px/1.5 ui-monospace,"SF Mono",Menlo,Consolas,monospace;word-break:break-word;white-space:pre-wrap;color:var(--blue)}
#rom:empty::before{content:"Romanized spelling appears here";font:14px system-ui,sans-serif;color:var(--mut)}
#pre:empty::before{content:"Preeti keystrokes appear here";font:14px system-ui,sans-serif;color:var(--mut)}
@media (min-width:700px){#out{font-size:36px}}
/* dock: hints, suggestions, keyboard and the toolbar row */
#dock{flex:none;border-top:1px solid var(--line);background:var(--bg);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
#info{min-height:20px;padding:0 6px;font-size:12.5px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#info b{color:var(--fg)}
#info:empty,#sug:empty{display:none}
#sug{display:flex;gap:6px;overflow-x:auto;padding:5px 2px 7px;min-height:58px;scrollbar-width:none;scroll-snap-type:x proximity}
#sug::-webkit-scrollbar{display:none}
.sg{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:3px 12px;text-align:center;line-height:1.2;min-width:48px;scroll-snap-align:start;animation:pop .18s ease-out both}
.sg.c{border-color:var(--ac);background:var(--ac-soft)}
.sg.w{border-color:var(--blue);background:var(--half)}
.sg.w .d{font-weight:600}
.sg.f{border-style:dashed}
.sg .d{display:block;font-size:21px}
.sg small{display:block;font-size:10px;color:var(--mut)}
@keyframes pop{from{opacity:0;transform:translateY(4px)}}
kbd{font:11px ui-monospace,monospace;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:0 4px;background:var(--surface2);color:var(--fg);margin:0 1px;display:inline-block}
.roman #kb,.roman .pk{display:none}
.row{display:flex;gap:4px;margin-bottom:4px}
#bar{margin:0}
.k{flex:1 1 0;min-width:0;height:clamp(40px,6.2vh,52px);position:relative;border-radius:8px;background:var(--key);box-shadow:0 1px 0 var(--keyline),0 0 0 1px var(--line) inset;font-size:clamp(16px,4.6vw,22px);user-select:none;-webkit-user-select:none;transition:transform .06s}
.k i{position:absolute;top:2px;left:4px;font:normal 9px ui-monospace,monospace;color:var(--mut)}
.k span{display:block}
.k.md span{font:10px system-ui,sans-serif;color:var(--mut)}
.k.h{background:var(--half);color:var(--blue)}
.k:active,.k.p{background:var(--ac);color:var(--ac-fg);transform:translateY(1px)}
.k:active i,.k.p i,.k:active.md span,.k.p.md span{color:var(--ac-fg)}
.k.w{flex:1.4 1 0;font:600 18px system-ui;background:var(--surface2)}
.k.sp{flex:4 1 0;font:13px system-ui;color:var(--mut);touch-action:none}
.k.on{background:var(--fg);color:var(--bg)}
/* toolbar keys: mode switch, chart, saved. Icons only beside the Preeti keyboard, labelled in Romanized mode */
.k.t{flex:1.2 1 0;background:var(--surface2);font:600 13px system-ui;display:inline-flex;align-items:center;justify-content:center;gap:5px;color:var(--fg)}
.k.t svg{width:18px;height:18px}
.k.t .tx{display:none}
.roman .k.t{flex:1;height:46px}.roman .k.t .tx{display:inline}
#mode{flex:1.6 1 0;background:var(--fg);color:var(--bg);font-size:12.5px}
#saved svg{fill:var(--ac);stroke:var(--ac)}
.n{min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--ac);color:var(--ac-fg);font-size:11px;font-weight:700;display:inline-grid;place-items:center}
.n:empty{display:none}
.bump{animation:bump .35s ease-out}
@keyframes bump{40%{transform:scale(1.25)}}
/* toast */
#t{position:fixed;top:calc(64px + env(safe-area-inset-top));left:50%;transform:translate(-50%,-8px);background:var(--fg);color:var(--bg);padding:8px 8px 8px 16px;border-radius:20px;opacity:0;transition:.2s;pointer-events:none;z-index:9;display:flex;gap:10px;align-items:center;font-size:14px;box-shadow:var(--shadow);max-width:calc(100% - 32px)}
.hd-off #t{top:calc(12px + env(safe-area-inset-top))}
#t.on{opacity:1;transform:translate(-50%,0);pointer-events:auto}
#t button{color:var(--ac);font-weight:650;padding:0 8px;min-height:28px}
#t button:empty{display:none}
#t:not(:has(button:not(:empty))){padding-right:16px}
/* sheet */
#bd{position:fixed;inset:0;background:rgba(0,0,0,.4);opacity:0;pointer-events:none;transition:.2s;z-index:5}
#sh{position:fixed;left:0;right:0;bottom:0;max-height:86dvh;display:flex;flex-direction:column;background:var(--bg);border-radius:20px 20px 0 0;transform:translateY(105%);transition:transform .28s cubic-bezier(.2,.8,.2,1);z-index:6;max-width:820px;margin:0 auto;box-shadow:0 -8px 30px rgba(0,0,0,.15)}
body.open #bd{opacity:1;pointer-events:auto}body.open #sh{transform:none}
.sh0{flex:none;display:flex;align-items:center;gap:8px;padding:12px 14px 0}.sh0 b{flex:1;font-size:16px}
a.bt{color:inherit;text-decoration:none}
#tabs{flex:none;display:flex;gap:4px;overflow-x:auto;padding:10px 14px;scrollbar-width:none;border-bottom:1px solid var(--line)}
#tabs::-webkit-scrollbar{display:none}
.tb{flex:none;padding:7px 13px;border-radius:16px;color:var(--mut);font-size:13.5px;font-weight:550}
.tb.on{background:var(--fg);color:var(--bg)}
#body{overflow:auto;padding:8px 14px calc(16px + env(safe-area-inset-bottom))}
.find{flex:none;padding:8px 14px 0}
#cq{width:100%;height:40px;border:1px solid var(--line);border-radius:12px;padding:0 14px;font:15px system-ui,sans-serif;background:var(--surface);color:var(--fg)}
#cq:focus{outline:none;border-color:var(--ac);box-shadow:0 0 0 3px var(--ac-soft)}
#p-b .jump{margin:0 -2px 6px}
#p-b .vr{scroll-margin-top:52px}
.pn{display:none}.pn.on{display:block}
.g{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.ch{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:5px 9px;text-align:center;min-width:62px;position:relative}
.ch .d{font-size:24px;display:block;line-height:1.3}
.ch kbd{display:block;width:max-content;margin:2px auto 0}
.ch.h{background:var(--half);min-width:70px}.ch.h .d{font-size:30px}
.ch .x{position:absolute;top:-8px;right:-8px;width:24px;height:24px;border-radius:12px;background:var(--fg);color:var(--bg);font-size:13px;line-height:24px}
.nt{color:var(--mut);font-size:13.5px;margin:8px 0}
li{margin:5px 0}
/* the assumed reading: a friendly guess at how the text is said (kathmandu), with its own copy button */
#asm{padding:2px 16px 12px;min-height:34px;font:600 18px/1.5 system-ui,sans-serif;color:var(--ac);word-break:break-word;white-space:pre-wrap}
.roman #ac{order:-1}
.hd-off #asm{padding-right:48px;padding-top:12px}
/* a live preview of the typed text inside the chart, so tapped letters can be seen landing */
.echo{flex:none;min-height:42px;padding:6px 14px;border-bottom:1px solid var(--line);font-size:22px;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.echo:empty::before{content:"Tap a letter to type it here";font:13px system-ui,sans-serif;color:var(--mut)}
.lnk{color:var(--ac);font-weight:650;text-decoration:underline;margin-left:6px}
/* report dialog */
#rep{border:0;padding:0;border-radius:20px;background:var(--bg);color:var(--fg);width:min(480px,calc(100% - 24px));max-height:calc(100dvh - 24px);box-shadow:0 20px 60px rgba(0,0,0,.35);overflow:auto}
#rep::backdrop{background:rgba(0,0,0,.55)}
.rh{display:flex;align-items:center;padding:14px 8px 0 18px}.rh h2{flex:1;margin:0;font-size:19px}
.rn{margin:6px 18px 12px;color:var(--mut);font-size:13.5px}
.rn a{color:var(--ac)}
.rl{display:grid;gap:8px;padding:0 14px 6px}
.rl button{text-align:left;border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:11px 14px;display:grid;gap:2px}
.rl button:hover,.rl button:focus-visible{border-color:var(--ac)}
.rl b{font-size:15px}.rl span{color:var(--mut);font-size:13px}
#rep2{padding:8px 18px 4px}
#rep2 .rn{margin-left:0;margin-right:0}
#rep2 h3{margin:10px 0 6px;font-size:17px}
.rfl{display:grid;gap:4px;margin:0 0 10px;font-size:13.5px;font-weight:600}
.rfl small{font-weight:400;color:var(--mut)}
.rfl input,.rfl textarea{font:15px/1.4 system-ui,sans-serif;border:1px solid var(--line);border-radius:10px;padding:8px 10px;background:var(--surface);color:var(--fg);width:100%;resize:vertical;font-weight:400}
.rfl input:focus,.rfl textarea:focus{outline:none;border-color:var(--ac);box-shadow:0 0 0 3px var(--ac-soft)}
.rfl .d,.rfl input.d,.rfl textarea.d{font-family:"Noto Sans Devanagari","Nirmala UI","Mangal",sans-serif}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.ra{display:flex;gap:8px;flex-wrap:wrap;margin:4px 0 4px}
#rep3{padding:6px 18px 18px}
#rep3 .rn{margin-left:0;margin-right:0}
.rok{margin:10px 0 0;font-size:17px;font-weight:650}
.rerr{margin:0 0 8px;color:var(--ac);font-size:13.5px;min-height:0}
.rerr:empty{display:none}
.sg.r{border-style:dashed;background:none}
.sg.r .d{font:600 14px system-ui,sans-serif;color:var(--mut);padding-top:4px}
/* welcome dialog */
#intro{border:0;padding:0;border-radius:20px;background:var(--bg);color:var(--fg);width:min(760px,calc(100% - 24px));max-height:calc(100dvh - 24px);box-shadow:0 20px 60px rgba(0,0,0,.35);overflow:auto}
#intro[open]{display:flex;flex-direction:column}
#intro::backdrop{background:rgba(0,0,0,.55)}
#intro video{display:block;width:100%;max-height:52dvh;background:#0e0e0f;object-fit:contain}
.ii{padding:14px 18px 16px}
.ii h2{margin:0 0 6px;font-size:20px}
.ii ul{margin:0 0 12px;padding-left:18px;color:var(--mut);font-size:14px}
.ii li b{color:var(--fg)}
.ia{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.ia .gh{width:16px;height:16px}
@media (min-width:700px){#intro[open]{flex-direction:row}#intro video{width:auto;height:min(78dvh,640px);max-height:none}.ii{align-self:center}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="app">
<header>
 <div class="brand"><div class="logo d" aria-hidden="true">क</div><div><h1>Nepali Type</h1><small>Unicode + Devanagari font, offline</small></div></div>
 <button class="pill" id="inst" hidden>Install</button>
 <button class="ib" id="report" aria-label="Report a problem, a missing word or an idea" title="Report a problem or idea"><svg viewBox="0 0 24 24"><path d="M4 22V4M4 4h13l-2 4 2 4H4"/></svg></button>
 <a class="ib" href={REPO} target="_blank" rel="noopener" aria-label="Source code on GitHub" title="Source code on GitHub"><Fragment set:html={GITHUB_ICON}/></a>
 <button class="ib" id="theme" aria-label="Toggle dark mode" title="Dark / light"><svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
 <button class="ib" id="hidehd" aria-label="Hide top bar" title="Hide top bar"><svg viewBox="0 0 24 24"><path d="m18 15-6-6-6 6"/></svg></button>
</header>
<main id="top">
 <section class="card">
  <div class="lab"><span>Unicode</span><span id="cnt"></span></div>
  <button class="cc" data-copy="uni" aria-label="Copy Unicode text" title="Copy Unicode text"><Fragment set:html={copy}/></button>
  <div id="out" class="d e" aria-live="polite"></div>
  <div class="acts">
   <button class="bt fav" id="fav" aria-pressed="false" aria-label="Save the last word" title="Save the last word"><Fragment set:html={star}/><span class="tx">Save</span></button>
   <span class="sp"></span>
   <button class="bt" id="cl" aria-label="Clear" title="Clear"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg></button>
  </div>
 </section>
 <section class="card" id="rc">
  <div class="lab"><span>Romanized</span></div>
  <button class="cc" data-copy="rom" aria-label="Copy Romanized text" title="Copy Romanized text"><Fragment set:html={copy}/></button>
  <textarea id="rin" placeholder="Type in English… namaste, nepal, dhanyabad" autocapitalize="none" autocomplete="off" autocorrect="off" spellcheck="false" aria-label="Romanized input"></textarea>
  <div id="rom"></div>
 </section>
 <section class="card" id="ac" hidden>
  <div class="lab"><span>Assumed</span></div>
  <button class="cc" data-copy="assumed" aria-label="Copy the assumed reading" title="Copy the assumed reading"><Fragment set:html={copy}/></button>
  <div id="asm"></div>
 </section>
 <section class="card" id="pk">
  <div class="lab"><span id="pkl">Preeti Keymap</span></div>
  <button class="cc" data-copy="font" aria-label="Copy Preeti keymap text" title="Copy Preeti keymap text"><Fragment set:html={copy}/></button>
  <button class="pb" id="paste" aria-label="Paste Preeti text" title="Paste Preeti text"><svg viewBox="0 0 24 24"><path d="M9 4h6v3H9zM9 5.5H6.5A1.5 1.5 0 0 0 5 7v12.5A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V7a1.5 1.5 0 0 0-1.5-1.5H15"/></svg></button>
  <textarea id="pin" placeholder="Type with your keyboard or paste Preeti text, for example g]kfn d]/f]" autocapitalize="none" autocomplete="off" autocorrect="off" spellcheck="false" aria-label="Preeti text: type or paste"></textarea>
  <div id="pre"></div>
 </section>
</main>
