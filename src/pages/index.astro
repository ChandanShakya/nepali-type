<div id="echo" class="echo d" aria-live="polite" title="What you have typed so far"></div>
<div id="tabs"></div><div class="find"><input id="cq" type="search" placeholder="Find a letter: ka, ksh, S, क…" aria-label="Find a letter" autocomplete="off" autocapitalize="none" spellcheck="false"></div><div id="body"><div class="pn" id="p-q"></div></div></div>
<div id="t" role="status"><span></span><button></button></div>
<!-- report a problem: each choice opens a prefilled GitHub issue -->
<dialog id="rep" aria-labelledby="repT">
 <form method="dialog" class="rh"><h2 id="repT">Report a problem or idea</h2><button class="ib" aria-label="Close">×</button></form>
 <!-- step 1: what kind -->
 <div id="rep1">
  <p class="rn">No account needed. Pick one, check the details, and send. It is posted publicly as an issue on GitHub.</p>
  <div class="rl" id="rtypes"></div>
  <p class="rn"><a href="/issues/">See open and solved reports</a></p>
 </div>
 <!-- step 2: the details -->
 <form id="rep2" hidden novalidate>
  <button type="button" class="bt" id="rback">← Back</button>
  <h3 id="rep2t"></h3>
  <div id="rf"></div>
  <label class="rfl">Your name <small>(optional, shown with the report)</small><input name="name" id="rname" maxlength="40" placeholder="Leave empty to stay anonymous" autocomplete="name"></label>
  <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
  <p class="rn">Sent without an account, as an issue by the project. Anyone can read it. Do not include private details.</p>
  <p id="rerr" class="rerr" role="alert"></p>
  <div class="ra"><button type="submit" class="bt p" id="rsend">Send report</button><button type="button" class="bt" id="rgh">Open on GitHub instead</button></div>
  <p class="rn">“Open on GitHub” uses your own GitHub account, so the issue is under your name.</p>
 </form>
 <!-- step 3: sent -->
 <div id="rep3" hidden>
  <p class="rok">Thank you! Your report was sent.</p>
  <p class="rn" id="rdone"></p>
  <div class="ra"><a class="bt p" id="rlink" href="/issues/">See all reports</a><button type="button" class="bt" id="rclose">Close</button></div>
 </div>
</dialog>
<!-- shown once on the first visit; reopened from Help → Watch the demo -->
<dialog id="intro" aria-labelledby="introT">
 <video src="/demo.mp4" poster="/demo.webp" muted loop playsinline controls preload="none" width="720" height="1280" aria-label="Nepali Type demo video"></video>
 <div class="ii">
  <h2 id="introT">Type Nepali the easy way</h2>
  <ul>
   <li><b>Romanized:</b> type how it sounds. <kbd>namaste</kbd> → नमस्ते. Blue words are dictionary suggestions.</li>
   <li><b>Preeti:</b> type or paste Preeti text, like in Word. It becomes Unicode and Romanized at once.</li>
   <li>Unicode, Romanized and font text side by side. Copy any box. Free, offline, no sign-up.</li>
  </ul>
  <form method="dialog" class="ia"><a class="bt" href="/chart/">Cheatsheet</a><a class="bt" href={REPO} target="_blank" rel="noopener"><Fragment set:html={GITHUB_ICON}/>GitHub</a><span class="sp"></span><button class="bt p" autofocus>Start typing</button></form>
 </div>
</dialog>
