---
// Open and solved reports. The page is static; the lists are loaded from /api/issues (a Cloudflare Pages Function).
import "../styles/base.css";
import {REPO, GITHUB_ICON} from "../data/site.js";
const site = Astro.site?.href ?? "/";
const url = new URL("/issues/", site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Reports: open and solved | Nepali Type</title>
<meta name="description" content="Missing words, bugs and ideas reported for Nepali Type, and which ones are already fixed.">
<meta name="robots" content="noindex">
<link rel="canonical" href={url}>
<meta name="theme-color" content="#faf8f5">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<script is:inline>
try{const t=localStorage.getItem("nw-theme");if(t)document.documentElement.dataset.theme=t}catch(e){}
</script>
<style is:global>
html,body{height:auto}
.wrap{max-width:760px;margin:0 auto;padding:0 16px 48px}
.top{position:sticky;top:0;z-index:3;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 0;padding-top:max(10px,env(safe-area-inset-top))}
.top .in{max-width:760px;margin:0 auto;padding:0 16px;display:flex;align-items:center;gap:10px}
.logo{width:32px;height:32px;border-radius:9px;background:var(--ac);color:var(--ac-fg);display:grid;place-items:center;font-size:20px;font-weight:700;flex:none;text-decoration:none}
.top b{flex:1;font-size:17px}
.gl{width:34px;height:34px;display:grid;place-items:center;color:var(--fg)}
.gl .gh{width:20px;height:20px;fill:currentColor}
.btn{height:34px;padding:0 14px;border-radius:17px;background:var(--ac);color:var(--ac-fg);font-weight:600;font-size:14px;display:inline-flex;align-items:center;text-decoration:none;white-space:nowrap}
h1{font-size:clamp(24px,5vw,34px);letter-spacing:-.02em;margin:24px 0 4px}
.lead{color:var(--mut);margin:0 0 14px}
.tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--surface2);border-radius:12px;padding:3px;gap:3px;margin:8px 0 14px}
.tabs button{padding:9px 4px;border-radius:9px;font-size:14px;font-weight:600;color:var(--mut)}
.tabs button[aria-selected="true"]{background:var(--surface);color:var(--fg);box-shadow:var(--shadow)}
.n{min-width:20px;height:20px;padding:0 6px;margin-left:6px;border-radius:10px;background:var(--ac);color:var(--ac-fg);font-size:12px;font-weight:700;display:inline-grid;place-items:center}
.n:empty{display:none}
ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}
li{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
li a{color:var(--fg);text-decoration:none;font-weight:650;overflow-wrap:anywhere}
li a:hover{color:var(--ac)}
li .num{color:var(--mut);font-weight:500;margin-right:6px}
.meta{color:var(--mut);font-size:13px;margin-top:4px;display:flex;flex-wrap:wrap;gap:4px 12px;align-items:center}
.lab{display:inline-flex;align-items:center;gap:5px}
.dot{width:9px;height:9px;border-radius:50%;flex:none}
.state{padding:12px 4px;color:var(--mut)}
.state button{color:var(--ac);font-weight:600;text-decoration:underline}
.ok{color:#1a7f37}
:root[data-theme="dark"] .ok{color:#56d364}
footer{margin-top:28px;color:var(--mut);font-size:13px}
footer a{color:var(--ac)}
</style>
</head>
<body>
<header class="top">
 <div class="in"><a class="logo d" href="/" aria-label="Back to Nepali Type">क</a><b>Reports</b><a class="gl" href={REPO + "/issues"} target="_blank" rel="noopener" aria-label="All issues on GitHub" title="All issues on GitHub"><Fragment set:html={GITHUB_ICON}/></a><a class="btn" href="/?report=1">Report</a></div>
</header>
<main class="wrap">
 <h1>Open and solved reports</h1>
 <p class="lead">Missing words, bugs and ideas people have sent in. Anyone can send one, no account needed. The newest changes are first.</p>
 <div class="tabs" role="tablist">
  <button role="tab" id="t-open" aria-selected="true" aria-controls="list">Open<span class="n" id="c-open"></span></button>
  <button role="tab" id="t-closed" aria-selected="false" aria-controls="list">Solved<span class="n" id="c-closed"></span></button>
 </div>
 <div id="list" role="tabpanel" aria-live="polite"></div>
 <footer>Reports are posted as issues in <a href={REPO} target="_blank" rel="noopener">the project on GitHub</a>. <a href="/">Back to typing →</a></footer>
</main>
<script>
const $ = (s: string) => document.querySelector(s) as HTMLElement;
type Issue = {number: number; title: string; url: string; solved: boolean; state: string; labels: {name: string; color: string}[]; comments: number; created: string; closed: string | null; by: string};
const rtf = new Intl.RelativeTimeFormat("en", {numeric: "auto"});
const ago = (iso: string) => {
  const s = (new Date(iso).getTime() - Date.now()) / 1000, a = Math.abs(s);
  const [n, u] = a < 3600 ? [s / 60, "minute"] : a < 86400 ? [s / 3600, "hour"] : a < 2592000 ? [s / 86400, "day"] : a < 31536000 ? [s / 2592000, "month"] : [s / 31536000, "year"];
  return rtf.format(Math.round(n), u as Intl.RelativeTimeFormatUnit);
};
const cache: Record<string, Issue[] | undefined> = {};
const el = (tag: string, cls = "", text = "") => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
function row(i: Issue, tab: string) {
  const li = el("li"), a = el("a", "", i.title) as HTMLAnchorElement;
  a.href = i.url; a.target = "_blank"; a.rel = "noopener";
  const num = el("span", "num", "#" + i.number);
  const meta = el("div", "meta");
  if (tab === "closed") meta.append(el("span", i.solved ? "ok" : "", i.solved ? "✓ Solved " + ago(i.closed || i.created) : "Closed, not planned " + ago(i.closed || i.created)));
  else meta.append(el("span", "", "Opened " + ago(i.created)));
  meta.append(el("span", "", i.by ? "by " + i.by : "anonymous"));
  if (i.comments) meta.append(el("span", "", i.comments + (i.comments === 1 ? " comment" : " comments")));
  for (const l of i.labels) { const s = el("span", "lab"), d = el("span", "dot"); d.style.background = /^[0-9a-f]{6}$/i.test(l.color) ? "#" + l.color : "var(--mut)"; s.append(d, l.name); meta.append(s); }
  li.append(num, a, meta);
  return li;
}
async function load(tab: "open" | "closed") {
  const box = $("#list");
  for (const t of ["open", "closed"]) $("#t-" + t).setAttribute("aria-selected", String(t === tab));
  if (!cache[tab]) {
    box.replaceChildren(el("p", "state", "Loading…"));
    try {
      const r = await fetch("/api/issues?state=" + tab);
      if (!r.ok) throw new Error(String(r.status));
      cache[tab] = (await r.json()).issues as Issue[];
    } catch {
      const p = el("p", "state", "The list could not be loaded. Are you offline? "), b = el("button", "", "Try again");
      b.onclick = () => load(tab); p.append(b); box.replaceChildren(p); return;
    }
  }
  const items = cache[tab]!;
    $("#c-" + tab).textContent = items.length ? String(items.length) : "";
  if (!items.length) { box.replaceChildren(el("p", "state", tab === "open" ? "No open reports right now. Thank you!" : "Nothing solved yet.")); return; }
  const ul = el("ul"); ul.append(...items.map((i) => row(i, tab))); box.replaceChildren(ul);
}
$("#t-open").onclick = () => load("open");
$("#t-closed").onclick = () => load("closed");
load("open");
// the other tab's count, so both numbers show from the start
fetch("/api/issues?state=closed").then((r) => r.json()).then((j) => { cache.closed = j.issues; $("#c-closed").textContent = j.issues.length ? String(j.issues.length) : ""; }).catch(() => {});
</script>
</body>
</html>
