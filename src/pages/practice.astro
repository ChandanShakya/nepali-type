---
import "../styles/base.css";
import {GITHUB_ICON, REPO} from "../data/site.js";
const site = Astro.site?.href ?? "/";
const url = new URL("/practice/", site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Typing practice | Nepali Type</title>
<meta name="description" content="Learn the Preeti keys: an on-screen keyboard that lights the next key, drills for rows, words and sentences, speed and accuracy.">
<link rel="canonical" href={url}>
<meta name="theme-color" content="#faf8f5">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<script is:inline>
try{const t=localStorage.getItem("nw-theme");if(t)document.documentElement.dataset.theme=t;const fs=localStorage.getItem("nw-fs");if(fs)document.documentElement.style.setProperty("--fs",fs+"px")}catch(e){}
</script>
<style is:global>
html,body{height:auto}
.wrap{max-width:680px;margin:0 auto;padding:0 16px 48px}
.top{position:sticky;top:0;z-index:3;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 0;padding-top:max(10px,env(safe-area-inset-top))}
.top .in{max-width:680px;margin:0 auto;padding:0 16px;display:flex;align-items:center;gap:10px}
.logo{width:32px;height:32px;border-radius:9px;background:var(--ac);color:var(--ac-fg);display:grid;place-items:center;font-size:20px;font-weight:700;line-height:1;padding-top:.13em;flex:none;text-decoration:none}
.top b{flex:1;font-size:17px}
h1{font-size:clamp(24px,5vw,32px);letter-spacing:-.02em;margin:24px 0 6px}
.lead{color:var(--mut);margin:0 0 18px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:16px}
.bt{height:38px;padding:0 14px;border-radius:10px;border:1px solid var(--line);background:var(--surface);font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;color:var(--fg);text-decoration:none}
.bt.p{background:var(--ac);border-color:var(--ac);color:var(--ac-fg)}
.state{color:var(--mut);font-size:14px;margin:10px 0 0}
footer{margin-top:28px;color:var(--mut);font-size:13px}
footer a{color:var(--ac)}
.seg{display:flex;background:var(--surface2);border-radius:12px;padding:3px;gap:3px;margin:0 0 12px}
.seg button{flex:1;height:36px;border-radius:9px;font-size:14px;font-weight:600;color:var(--mut);border:0;background:none;cursor:pointer}
.seg button.on{background:var(--surface);color:var(--fg);box-shadow:0 0 0 1px var(--line)}
.pills{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px}
.pills[hidden]{display:none}
.pills button{height:32px;padding:0 12px;border-radius:16px;border:1px solid var(--line);background:var(--surface);font-size:13px;font-weight:600;color:var(--mut);cursor:pointer}
.pills button.on{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.stats{display:flex;gap:16px;color:var(--mut);font-size:13px;margin:0 0 8px}
.stats b{color:var(--fg);font-size:18px;font-weight:650}
.bar{height:4px;border-radius:2px;background:var(--surface2);overflow:hidden;margin:0 0 14px}
.bar i{display:block;height:100%;width:0;background:var(--ac);transition:width .12s}
#tg{font-size:calc(var(--fs,20px) + 6px);line-height:1.7;margin:0 0 6px;color:var(--mut);min-height:3.4em;word-break:break-word}
#tg .dn{color:var(--fg)}
#fin p{margin:0 0 6px;font-weight:650;color:var(--ac)}
.kbd{display:grid;gap:4px;margin-top:10px;user-select:none;-webkit-user-select:none;touch-action:manipulation}
.kr{display:flex;gap:4px}
.kk{flex:1 1 0;min-width:0;height:clamp(38px,9.5vw,48px);position:relative;border-radius:8px;border:0;background:var(--surface2);box-shadow:inset 0 0 0 1px var(--line);color:var(--fg);font-size:clamp(15px,4.4vw,20px);display:grid;place-items:center;line-height:1;padding:0;cursor:pointer}
.kk i{position:absolute;top:2px;left:4px;font:normal 9px ui-monospace,monospace;color:var(--mut)}
.kk.w{flex:1.5 1 0;font:600 16px system-ui}.kk.sp{flex:6 1 0;font:13px system-ui;color:var(--mut)}
.kk.nx{background:var(--ac);color:var(--ac-fg);box-shadow:none}.kk.nx i{color:var(--ac-fg)}
.kk.on{background:var(--fg);color:var(--bg)}
.kk.g{background:#1a7f37;color:#fff;box-shadow:none}.kk.b{background:#d1242f;color:#fff;box-shadow:none}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:14px}
</style>
</head>
<body>
<header class="top">
 <div class="in"><a class="logo d" href="/" aria-label="Back to Nepali Type">क</a><b>Typing practice</b><a class="bt" href="/">Type →</a></div>
</header>
<main class="wrap">
 <h1>Typing practice</h1>
 <p class="lead">Type what you see. The next key lights up; a wrong key does not move you on.</p>
 <div class="seg" id="tabs" role="tablist"><button data-t="keys" role="tab">Keys</button><button data-t="words" role="tab">Words</button><button data-t="text" role="tab">Sentences</button></div>
 <div class="pills" id="sets"></div>
 <div class="card">
  <div class="stats"><span><b id="s1">0</b> WPM</span><span><b id="s2">100%</b> accurate</span><span><b id="s3">0:00</b></span></div>
  <div class="bar"><i id="pg"></i></div>
  <div id="tg" class="d" aria-label="What to type"></div>
  <div id="fin" hidden><p id="fres"></p></div>
  <div class="kbd" id="kb"></div>
  <div class="row"><button class="bt p" id="nx">Next</button><button class="bt" id="rs">Restart</button></div>
 </div>
 <p class="state" id="bs"></p>
 <footer><a href="/">Nepali Type</a> · <a href="/chart/">Cheatsheet</a> · <a href={REPO} target="_blank" rel="noopener">GitHub</a></footer>
</main>
<script>
import "../scripts/practice.js";
</script>
</body>
</html>
